# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Redis (Upstash) — signal layer; jobs table is the system of record
REDIS_URL=""

# Auth / sessions
JWT_ACCESS_SECRET="replace-with-at-least-32-random-bytes"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# AI provider (Groq, OpenAI-compatible). AI_ENABLED=false keeps AI surfaces
# disabled/honest; set true + a valid key to run live agent paths.
GROQ_API_KEY=""
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_MODEL="llama-3.3-70b-versatile"
AI_MAX_STEPS=10
AI_MAX_TOOL_CALLS=12
AI_TIMEOUT_MS=60000
AI_MAX_TOKENS=2048
# Budget knobs: AI_MAX_TOKENS is the legacy fallback; the dedicated
# input/output caps let you bound the cumulative run budget and the
# per-request max output independently (keeps free-tier TPM friendly).
AI_MAX_INPUT_TOKENS=16000
AI_MAX_OUTPUT_TOKENS=4096
AI_ENABLED=false

# Object storage (Cloudflare R2) — leave empty to use local backend/uploads/ fallback
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="GrowMetrics-uploads"
R2_ENDPOINT=""

# Dev storage fallback directory (gitignored)
UPLOAD_DIR="./uploads"

# Ingestor limits
IMPORT_ROW_CAP=200000
IMPORT_MAX_FILE_BYTES=26214400

# Encryption key for external-DB credentials (AES-256-GCM).
# Recommended: a 32+ byte secret. If empty, derived from JWT_ACCESS_SECRET for local dev.
DATA_SOURCE_ENCRYPTION_KEY=""
